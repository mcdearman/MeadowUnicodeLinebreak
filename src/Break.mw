-- Apache License, Version 2.0: see LICENSE and COPYRIGHT.

use Std.Collections.Vector as V
use UnicodeLinebreak.Lookup (classOf, transition, isSafePair)

-- A line break class, as UAX #14 names them.
@pub data BreakClass =
  -- Causes a line break after it.
  Mandatory
  -- Causes a line break after it, except between CR and LF.
  | CarriageReturn
  -- Causes a line break after it.
  | LineFeed
  -- Prohibits a line break between it and the character before.
  | CombiningMark
  -- Causes a line break after it.
  | NextLine
  -- Does not occur in well-formed text.
  | Surrogate
  -- Prohibits line breaks before and after it.
  | WordJoiner
  -- Provides a break opportunity.
  | ZeroWidthSpace
  -- Prohibits line breaks before and after it.
  | NonBreakingGlue
  -- Enables indirect line breaks.
  | Space
  -- Prohibits line breaks within joiner sequences.
  | ZeroWidthJoiner
  -- Provides a line break opportunity before and after it.
  | BeforeAndAfter
  -- Generally provides a line break opportunity after it.
  | After
  -- Generally provides a line break opportunity before it.
  | Before
  -- Provides a line break opportunity after it, except in numeric context.
  | Hyphen
  -- Provides a line break opportunity contingent on more information.
  | Contingent
  -- Prohibits line breaks before it.
  | ClosePunctuation
  -- Prohibits line breaks before it.
  | CloseParenthesis
  -- Prohibits line breaks before it.
  | Exclamation
  -- Allows only indirect line breaks between pairs.
  | Inseparable
  -- Allows only indirect line breaks before it.
  | NonStarter
  -- Prohibits line breaks after it.
  | OpenPunctuation
  -- Acts as both opening and closing.
  | Quotation
  -- Prevents breaks after any and before numeric.
  | InfixSeparator
  -- Forms numeric expressions for line breaking purposes.
  | Numeric
  -- Does not break following a numeric expression.
  | Postfix
  -- Does not break in front of a numeric expression.
  | Prefix
  -- Prevents a break before it, and allows one after.
  | Symbol
  -- Acts like Alphabetic when the resolved East Asian width is narrow;
  -- otherwise like Ideographic.
  | Ambiguous
  -- Alphabetic characters, and symbols used with them.
  | Alphabetic
  -- Treated as NonStarter or Ideographic for strict or normal breaking.
  | ConditionalJapaneseStarter
  -- Does not break from a following emoji modifier.
  | EmojiBase
  -- Does not break from a preceding emoji base.
  | EmojiModifier
  -- Forms Korean syllable blocks.
  | HangulLvSyllable
  -- Forms Korean syllable blocks.
  | HangulLvtSyllable
  -- Does not break around a following hyphen; otherwise alphabetic.
  | HebrewLetter
  -- Breaks before or after it, except in some numeric context.
  | Ideographic
  -- Forms Korean syllable blocks.
  | HangulLJamo
  -- Forms Korean syllable blocks.
  | HangulVJamo
  -- Forms Korean syllable blocks.
  | HangulTJamo
  -- Keeps pairs together; breaks before and after other classes.
  | RegionalIndicator
  -- Provides a line break opportunity that depends on language-specific
  -- analysis.
  | ComplexContext
  -- Unknown line breaking behaviour, or unassigned.
  | Unknown

use BreakClass.*

-- The classes in the order `Tables.mw` numbers them.
def allClasses =
  #[
    Mandatory,
    CarriageReturn,
    LineFeed,
    CombiningMark,
    NextLine,
    Surrogate,
    WordJoiner,
    ZeroWidthSpace,
    NonBreakingGlue,
    Space,
    ZeroWidthJoiner,
    BeforeAndAfter,
    After,
    Before,
    Hyphen,
    Contingent,
    ClosePunctuation,
    CloseParenthesis,
    Exclamation,
    Inseparable,
    NonStarter,
    OpenPunctuation,
    Quotation,
    InfixSeparator,
    Numeric,
    Postfix,
    Prefix,
    Symbol,
    Ambiguous,
    Alphabetic,
    ConditionalJapaneseStarter,
    EmojiBase,
    EmojiModifier,
    HangulLvSyllable,
    HangulLvtSyllable,
    HebrewLetter,
    Ideographic,
    HangulLJamo,
    HangulVJamo,
    HangulTJamo,
    RegionalIndicator,
    ComplexContext,
    Unknown
  ]

-- The line break class of the code point `cp`. Like the crate's, it takes any
-- number, surrogates included.
@pub fun breakProperty cp = arrayGet allClasses (classOf cp)

-- What kind of break opportunity `linebreaks` found.
@pub data BreakOpportunity =
  -- A line must break here.
  Mandatory
  -- A line may end here.
  | Allowed

-- The class numbers the driver needs.
def zwjClass = 10
def eot = 43
def sot = 44

fun utf8Len cp =
  if cp < 0x80
  then 1
  else if cp < 0x800
  then 2
  else if cp < 0x10000
  then 3
  else 4

-- One step: the entry for `state` meeting `cls`, what it says about the break
-- before, and the next state.
fun scan chars i at state afterZwj out =
  let done = i >= arrayLen chars in
  let cp = if done then 0 else charCode (arrayGet chars i) in
  let cls = if done then eot else classOf cp in
  let val = transition state cls in
  let mandatory = bitAnd val 64 != 0 in
  let isBreak = bitAnd val 128 != 0 and (not afterZwj or mandatory) in
  let kind = if mandatory then BreakOpportunity.Mandatory else BreakOpportunity.Allowed in
  let out2 = if isBreak then V.pushBack out (at, kind) else out in
  if done
  then out2
  else scan chars (i + 1) (at + utf8Len cp) (bitAnd val 63) (cls == zwjClass) out2

-- The line break opportunities in `s`: the byte offset of the character after
-- each break, and whether the break is mandatory. The end of the text is
-- always one, so that every line ends in a break.
--
--   linebreaks "a b \nc"  -- [(2, Allowed), (5, Mandatory), (6, Mandatory)]
@pub fun linebreaks s = scan (stringToChars s) 0 0 sot False V.empty

fun offsetsFrom chars i at acc =
  if i >= arrayLen chars
  then acc
  else offsetsFrom chars (i + 1) (at + utf8Len (charCode (arrayGet chars i))) (V.pushBack acc at)

-- From the last pair of characters back, the first that is safe to resume
-- from; then where the character before it starts.
fun safeFrom chars offsets k =
  if k < 0
  then 0
  else
    let a = classOf (charCode (arrayGet chars k)) in
    let b = classOf (charCode (arrayGet chars (k + 1))) in
    if isSafePair a b
    then (if k > 0 then V.getOr 0 offsets (k - 1) else 0)
    else safeFrom chars offsets (k - 1)

-- `s` divided at the last place where the breaks that follow no longer depend
-- on what came before, so that `linebreaks` of the second part gives the same
-- breaks as `linebreaks s` does there. The break at the end is not counted.
@pub fun splitAtSafe s =
  let chars = stringToChars s in
  let at = safeFrom chars (offsetsFrom chars 0 0 V.empty) (arrayLen chars - 2) in
  (stringSlice s 0 at, stringSlice s at (stringByteLength s))
